# ---- کپی به .env و پر کردن مقادیر ----
# (هیچ مقدار واقعی در این فایل نگذارید)

# مسیر دیتابیس (اختیاری؛ پیش‌فرض از configs/config.yaml)
DB_PATH=data/bourse.db

# سطح لاگ: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- LLM برای تحلیل احساسات اخبار (اختیاری) ----
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
HUGGINGFACE_TOKEN=

# ---- کدال ----
CODAL_BASE_URL=https://search.codal.ir

# ---- API ----
API_HOST=127.0.0.1
API_PORT=8000
